# Copy to `.env` in the repo root. Every variable is optional:
# the app runs fine with no .env at all (CSV import + manual entry only).

# --- SimpleFIN bank sync -----------------------------------------------------
# A claimed SimpleFIN Access URL. If set and no connection exists yet, one is
# created on startup. You can skip this and paste a setup token in the UI instead
# (Accounts → Bank Sync).
# SIMPLEFIN_ACCESS_URL_PROD="https://user:pass@beta-bridge.simplefin.org/simplefin"

# Key used to encrypt the stored Access URL. If unset, a key is generated and
# saved to data/.simplefin_key on first use. Back that file up with data/budget.db.
# SIMPLEFIN_ENCRYPTION_KEY=

# Local cap on all-accounts SimpleFIN requests per connection per rolling 24h.
# SIMPLEFIN_MAX_REQUESTS_PER_DAY=24

# Override the SimpleFIN root URL used for protocol checks.
# SIMPLEFIN_ROOT_URL=

# --- Backend -----------------------------------------------------------------
# Extra origins allowed to call the API (comma-separated). localhost on any port
# is always allowed.
# CORS_ALLOW_ORIGINS=
